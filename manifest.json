{
  "manifest_version": 3,
  "name": "Magnet Grabber v2026.07.02__06.42.15",
    "description": "A privacy-focused magnet link utility. Stealthily identifies and logs links while preventing website fingerprinting. Features formatted exports for LibreOffice and one-click data/clipboard purging.",
  "version": "2026.7.2.24135",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage",
    "downloads"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": "icons/icon-toolbar/magnet-grabber-classic-red-white-horseshoe-magnet-indigo-background.svg",
	"default_popup": "popup.html",
    "default_title": "Magnet Grabber Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "32": "icons/icon-toolbar/magnet-grabber-classic-red-white-horseshoe-magnet-indigo-background.svg",
    "48": "icons/icon-toolbar/magnet-grabber-classic-red-white-horseshoe-magnet-indigo-background.svg",
    "96": "icons/icon-toolbar/magnet-grabber-classic-red-white-horseshoe-magnet-indigo-background.svg",
    "128": "icons/icon-toolbar/magnet-grabber-classic-red-white-horseshoe-magnet-indigo-background.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "magnet-grabber@pwshagyjkcrg761.codeberg.org",
	  "update_url": "https://codeberg.org/pwshAgyjkcrg761/Magnet-Grabber/raw/branch/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}